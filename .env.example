# Flutter GraphQL endpoint configuration.
#
# Priority:
# 1. --dart-define=GRAPHQL_URL=...
# 2. .env GRAPHQL_URL=...
# 3. Android emulator fallback: http://10.0.2.2:3000/graphql
# 4. iOS simulator / desktop / web fallback: http://localhost:3000/graphql
#
# Android emulator:
# GRAPHQL_URL=
#
# iOS simulator:
# GRAPHQL_URL=
#
# Desktop/web on the same machine as the backend:
# GRAPHQL_URL=
#
# Mac real iPhone:
# GRAPHQL_URL=http://<mac-hostname>.local:3000/graphql
#
# Windows real Android phone:
# GRAPHQL_URL=http://<windows-lan-ip>:3000/graphql

GRAPHQL_URL=
